# ZenFlow Enterprise Platform Configuration Template

# Backend Gateway Port & Database
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/zenflow

# Python AI Microservice (FastAPI RAG)
AI_SERVICE_URL=http://127.0.0.1:8000/api/v1/rag/query

# Optional LLM API Keys (ZenFlow operates with grounded offline RAG if left blank)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CONFIDENCE_THRESHOLD=0.60
